{
  "name": "baltic-nuoma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-messages.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && node scripts/build-setup-sql.mjs --check",
    "supabase": "npx -y supabase@3.3.0",
    "db:start": "npx -y supabase@3.3.0 start",
    "db:stop": "npx -y supabase@3.3.0 stop",
    "db:reset": "npx -y supabase@3.3.0 db reset",
    "db:test": "npx -y supabase@3.3.0 test db",
    "db:lint": "npx -y supabase@3.3.0 db lint --level warning",
    "db:push": "npx -y supabase@3.3.0 db push",
    "db:types": "npx -y supabase@3.3.0 gen types typescript --local --schema public > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "db:types:remote": "npx -y supabase@3.3.0 gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "seed:admin": "node --env-file=.env.local scripts/seed-admin.mjs",
    "db:bundle": "node scripts/build-setup-sql.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^7.0.9",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "lenis": "^1.3.28",
    "lucide-react": "^1.79.0",
    "next": "15.5.29",
    "next-intl": "^4.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.92.0",
    "resend": "^6.39.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.18"
  }
}
