# ─────────────────────────────────────────────────────────────────────────────
# Baltic Nuoma — environment variables
# Copy to `.env.local` for local development. On Vercel, set them in
# Project → Settings → Environment Variables. Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash). Used for metadata, sitemap, OG, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Telegram username without "@". Leave empty to hide the Telegram button.
NEXT_PUBLIC_TELEGRAM_USERNAME=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key may also be a new-style "publishable" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Service role (or new-style "secret") key — bypasses RLS. Used for
# creating bookings, cron jobs and the admin seed script. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Project ref, used by `npm run db:types` (supabase gen types).
SUPABASE_PROJECT_ID=

# ── First admin (used once by `npm run seed:admin`) ──────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administratorius

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Sender — the domain must be verified in Resend.
EMAIL_FROM="Baltic Nuoma <rezervacijos@example.lt>"
# Where new booking requests are sent (manager inbox). Also editable in admin → Nustatymai.
BOOKING_NOTIFY_EMAIL=

# ── 3D generation from photos ────────────────────────────────────────────────
# Default provider: meshy | tripo | mock (mock returns a test GLB — no credits spent).
THREE_D_PROVIDER=mock
# https://www.meshy.ai → API keys
MESHY_API_KEY=
# https://fal.ai → keys (Tripo via fal.ai)
FAL_KEY=
# Shared secret for Vercel Cron → /api/3d/poll (Vercel sends it as a Bearer token).
CRON_SECRET=

# ── Booking protection ───────────────────────────────────────────────────────
# Max booking requests per IP per hour (server-side rate limit).
BOOKING_RATE_LIMIT_PER_HOUR=5

# ── Analytics (optional; loaded only after cookie consent) ───────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
